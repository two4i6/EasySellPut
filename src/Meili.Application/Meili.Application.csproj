<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Meili.Core/Meili.Core.csproj" />
    <ProjectReference Include="../Meili.Data/Meili.Data.csproj" />
    <ProjectReference Include="../Meili.Analytics/Meili.Analytics.csproj" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../web/qqq-gex/node-runtime-lock.json" LogicalName="QqqGexRuntime/node-lock.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../skills/easysellput-local/SKILL.md" LogicalName="EasySellPut.Skill" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Updates/update-public-key.pem" LogicalName="EasySellPut.UpdatePublicKey" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Meili.Automation.Tests" /></ItemGroup>
  <Target Name="BuildQqqGexRuntime" BeforeTargets="AssignTargetPaths">
    <Exec Condition="!Exists('../../web/qqq-gex/node_modules/esbuild/package.json')" WorkingDirectory="../../web/qqq-gex" Command="npm ci --no-audit --no-fund" />
    <Exec WorkingDirectory="../../web/qqq-gex" Command="npm run build:runtime" />
    <ItemGroup><EmbeddedResource Include="../../web/qqq-gex/runtime-dist/import.mjs" LogicalName="QqqGexRuntime/import.mjs" /><EmbeddedResource Include="../../web/qqq-gex/runtime-dist/query.mjs" LogicalName="QqqGexRuntime/query.mjs" /><EmbeddedResource Include="../../web/qqq-gex/runtime-dist/history.mjs" LogicalName="QqqGexRuntime/history.mjs" /></ItemGroup>
  </Target>
</Project>
