<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Meili.App.Views.Controls" xmlns:vm="clr-namespace:Meili.Shared.ViewModels;assembly=Meili.Shared" x:Class="Meili.App.Views.Controls.LiquidityPanel">
<StackPanel AutomationProperties.AutomationId="MarketLiquidityPanel">
 <DockPanel><Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" ToolTip="{DynamicResource Dash_Refresh}" AutomationProperties.Name="{DynamicResource Dash_Refresh}"><c:LucideIcon Kind="Refresh" Width="18" Height="18"/></Button><TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0"/><c:AppHelp DockPanel.Dock="Right" HelpText="{DynamicResource Liq_MacroHelp}"/><TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Liq_Title}" VerticalAlignment="Center"/></DockPanel>
 <c:AppLoading Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
 <c:AppCard Padding="16" Margin="0,0,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Width="{StaticResource GaugeWidth}" Height="{StaticResource GaugeHeight}" Margin="0,0,24,0">
   <c:AppGauge Value="{Binding PressureValue}" LowBrush="{DynamicResource HealthyBrush}" NormalBrush="{DynamicResource UnknownBrush}" HighBrush="{DynamicResource DegradedBrush}" CriticalBrush="{DynamicResource DangerBrush}" MarkerBrush="{DynamicResource TextFillColorPrimaryBrush}"/>
   <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{Binding PressureText}" FontSize="{StaticResource DisplayFontSize}"/><TextBlock Text="/100" Style="{StaticResource Caption}" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{Binding PressureBand}" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel>
  </Grid>
  <StackPanel Grid.Column="1" VerticalAlignment="Center"><DockPanel><c:AppHelp DockPanel.Dock="Right" HelpText="{Binding PressureHelp}"/><TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Liq_PressureTitle}" VerticalAlignment="Center"/></DockPanel><TextBlock Style="{StaticResource Body}" Text="{DynamicResource Liq_PressureNote}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Liq_PressureWeights}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource Caption}" Text="{Binding PressureDates}" TextWrapping="Wrap"/></StackPanel>
 </Grid></c:AppCard>
 <ItemsControl ItemsSource="{Binding Metrics}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
  <c:AppCard Margin="0,0,8,8" Padding="16"><StackPanel><DockPanel><c:AppHelp DockPanel.Dock="Right" HelpText="{Binding Help}"/><TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" VerticalAlignment="Center"/></DockPanel><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Value}" FontSize="{StaticResource DisplayFontSize}"/><TextBlock Style="{StaticResource Caption}" Text="{Binding Unit}" VerticalAlignment="Center"/></StackPanel><TextBlock Style="{StaticResource Caption}" Text="{Binding Date}" TextWrapping="Wrap"/></StackPanel></c:AppCard>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <DockPanel Margin="0,8,0,0"><c:AppHelp DockPanel.Dock="Right" HelpText="{DynamicResource Liq_HeatHelp}"/><TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Liq_HeatTitle}" VerticalAlignment="Center"/></DockPanel>
 <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Liq_Legend}"/>
 <ItemsControl ItemsSource="{Binding Sectors}" x:Name="SectorHeatmap"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
 <c:AppActionCard Margin="0,0,8,8" Padding="14" Background="{Binding HeatBrush}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenSectorCommand, RelativeSource={RelativeSource AncestorType={x:Type c:LiquidityPanel}}}" CommandParameter="{Binding Symbol}" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Symbol}"/><TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Value}" FontSize="{StaticResource DisplayFontSize}"/><TextBlock Style="{StaticResource Caption}" Text="{Binding Date}"/></StackPanel></c:AppActionCard>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel>
</UserControl>
