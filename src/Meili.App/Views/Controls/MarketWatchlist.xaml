<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Meili.App.Views.Controls"
             xmlns:lucide="clr-namespace:Meili.App.Views.Controls"
             x:Class="Meili.App.Views.Controls.MarketWatchlist"
             x:Name="Watchlist">
    <UserControl.Resources>
        <Style x:Key="WorkspaceChange" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource NumberFont}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUp}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource UpBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDown}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DownBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkspaceYear" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource NumberFont}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsYearUp}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource UpBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsYearDown}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DownBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WatchlistSparklineStyle" TargetType="controls:QuoteSparkline">
            <Setter Property="LineBrush" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SparklineUp}" Value="True"><Setter Property="LineBrush" Value="{DynamicResource UpBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding SparklineDown}" Value="True"><Setter Property="LineBrush" Value="{DynamicResource DownBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid >
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="10,8,10,4">
            <DockPanel>
                <controls:AppPopover x:Name="MiniIndicatorSettings" DockPanel.Dock="Right" Margin="4,0,0,0" PopupWidth="256"
                                     Header="{DynamicResource Workspace_MiniIndicators}" Visibility="{Binding ShowSparkline, Converter={StaticResource BoolToVis}}">
                    <controls:AppPopover.PopupContent>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Workspace_MiniIndicators}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DockPanel Margin="0,0,0,6">
                                <controls:AppSelect DockPanel.Dock="Right" Width="76" ItemsSource="{Binding IndicatorPeriods}"
                                                    SelectedItem="{Binding MiniMaPeriod, Mode=TwoWay}" IsEnabled="{Binding ShowMiniMa}"
                                                    AutomationProperties.Name="{DynamicResource Workspace_MaPeriod}"/>
                                <CheckBox Content="MA" IsChecked="{Binding ShowMiniMa, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel>
                                <controls:AppSelect DockPanel.Dock="Right" Width="76" ItemsSource="{Binding IndicatorPeriods}"
                                                    SelectedItem="{Binding MiniEmaPeriod, Mode=TwoWay}" IsEnabled="{Binding ShowMiniEma}"
                                                    AutomationProperties.Name="{DynamicResource Workspace_EmaPeriod}"/>
                                <CheckBox Content="EMA" IsChecked="{Binding ShowMiniEma, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <CheckBox Content="VWAP" IsChecked="{Binding ShowMiniVwap, Mode=TwoWay}" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Workspace_IndicatorPeriodHelp}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding IndicatorError}" TextWrapping="Wrap" Foreground="{DynamicResource DegradedBrush}"
                                       Visibility="{Binding IndicatorError, Converter={StaticResource NonEmptyToVis}}"/>
                            <Button Content="{DynamicResource Workspace_ApplyIndicators}" Command="{Binding ApplyMiniIndicatorsCommand}"
                                    HorizontalAlignment="Right" Margin="0,10,0,0"/>
                        </StackPanel>
                    </controls:AppPopover.PopupContent>
                </controls:AppPopover>
                <controls:AppSelect DockPanel.Dock="Right" Margin="6,0,0,0" ItemsSource="{Binding IntradayChoices}"
                                    SelectedItem="{Binding IntradayChoice, Mode=TwoWay}" DisplayMemberPath="Name" Visibility="{Binding ShowSparkline, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.Name="{DynamicResource Workspace_IntradayView}"/>
                <controls:AppSelect ItemsSource="{Binding Groups}" SelectedItem="{Binding Group, Mode=TwoWay}" DisplayMemberPath="Name"
                                AutomationProperties.Name="{DynamicResource QP_Watchlist}"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowSparkline, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Caption}" Text="{Binding MiniMaLabel}" Foreground="{DynamicResource SparklineMaBrush}"
                           Margin="0,4,8,0" Visibility="{Binding MiniMaLabel, Converter={StaticResource NonEmptyToVis}}"/>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding MiniEmaLabel}" Foreground="{DynamicResource SparklineEmaBrush}"
                           Margin="0,4,8,0" Visibility="{Binding MiniEmaLabel, Converter={StaticResource NonEmptyToVis}}"/>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding MiniVwapLabel}" Foreground="{DynamicResource SparklineVwapBrush}"
                           Margin="0,4,0,0" Visibility="{Binding MiniVwapLabel, Converter={StaticResource NonEmptyToVis}}"/>
            </StackPanel>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Workspace_Symbol}" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1" Width="84" Visibility="{Binding ShowSparkline, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Grid.Column="2" Width="{Binding NumberColumnWidth}" Style="{StaticResource Caption}" Text="{DynamicResource Workspace_Last}" TextAlignment="Right"/>
                <TextBlock Grid.Column="3" Width="{Binding NumberColumnWidth}" Style="{StaticResource Caption}" Text="{DynamicResource Workspace_ChangePct}" TextAlignment="Right" Visibility="{Binding ShowSparkline, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Grid.Column="4" Width="{Binding NumberColumnWidth}" Style="{StaticResource Caption}" Text="{DynamicResource Workspace_ChangeAmount}" TextAlignment="Right" Visibility="{Binding ShowAbsolute, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Grid.Column="5" Width="{Binding NumberColumnWidth}" Style="{StaticResource Caption}" Text="{DynamicResource Workspace_Ytd}" TextAlignment="Right" Visibility="{Binding ShowYear, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Grid.Column="6" Width="{Binding NumberColumnWidth}" Style="{StaticResource Caption}" Text="{DynamicResource Workspace_Rvol}" TextAlignment="Right" Visibility="{Binding ShowSessionMetrics, Converter={StaticResource BoolToVis}}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="7" Width="{Binding NumberColumnWidth}" Style="{StaticResource Caption}" Text="{DynamicResource Workspace_RangePosition}" TextAlignment="Right" Visibility="{Binding ShowSessionMetrics, Converter={StaticResource BoolToVis}}" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding WatchlistStatus}" TextWrapping="Wrap"
                       Visibility="{Binding WatchlistStatus, Converter={StaticResource NonEmptyToVis}}"
                       Foreground="{DynamicResource DegradedBrush}"/>
        </StackPanel>
        <ListBox x:Name="WorkspaceWatchRows" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selection, Mode=TwoWay}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{DynamicResource QP_Watchlist}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="MinHeight" Value="40"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid >
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding ExtendedLabel}" Visibility="{Binding HasExtended, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Extended}"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="84" VerticalAlignment="Center" Visibility="{Binding DataContext.ShowSparkline, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" ToolTip="{Binding SparklineTip}">
                            <StackPanel Visibility="{Binding HasSparkline, Converter={StaticResource BoolToVis}}">
                                <controls:QuoteSparkline Data="{Binding Sparkline}" Style="{StaticResource WatchlistSparklineStyle}" Height="30"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding SparklineCaption}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding VwapDistanceLabel}" Foreground="{DynamicResource SparklineVwapBrush}"
                                           TextTrimming="CharacterEllipsis" Visibility="{Binding VwapDistanceLabel, Converter={StaticResource NonEmptyToVis}}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="—" HorizontalAlignment="Center" Visibility="{Binding HasSparkline, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                        <StackPanel Grid.Column="2" Width="{Binding DataContext.NumberColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource NumberFont}" Text="{Binding Price}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource WorkspaceChange}" Text="{Binding Change}" HorizontalAlignment="Right" Visibility="{Binding DataContext.ShowSparkline, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBoolToVis}}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding ExtendedPrice}" HorizontalAlignment="Right" Visibility="{Binding HasExtended, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Extended}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Width="{Binding DataContext.NumberColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" VerticalAlignment="Center" Visibility="{Binding DataContext.ShowSparkline, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource WorkspaceChange}" Text="{Binding Change}" HorizontalAlignment="Right"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding ExtendedChange}" HorizontalAlignment="Right" Visibility="{Binding HasExtended, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Extended}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Width="{Binding DataContext.NumberColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" Style="{StaticResource WorkspaceChange}" Text="{Binding Absolute}" TextAlignment="Right" VerticalAlignment="Center" Visibility="{Binding DataContext.ShowAbsolute, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Column="5" Width="{Binding DataContext.NumberColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" Style="{StaticResource WorkspaceYear}" Text="{Binding Year}" TextAlignment="Right"
                                   VerticalAlignment="Center" Visibility="{Binding DataContext.ShowYear, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" ToolTip="{Binding YearTip}"/>
                        <TextBlock Grid.Column="6" Width="{Binding DataContext.NumberColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" FontFamily="{DynamicResource NumberFont}" Text="{Binding RelativeVolume}"
                                   TextAlignment="Right" VerticalAlignment="Center" Visibility="{Binding DataContext.ShowSessionMetrics, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" ToolTip="{Binding RelativeVolumeTip}"/>
                        <StackPanel Grid.Column="7" Width="{Binding DataContext.NumberColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" VerticalAlignment="Center"
                                    Visibility="{Binding DataContext.ShowSessionMetrics, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" ToolTip="{Binding RangePositionTip}">
                            <TextBlock FontFamily="{DynamicResource NumberFont}" Text="{Binding RangePosition}" HorizontalAlignment="Right"/>
                            <ProgressBar Value="{Binding RangePercent, Mode=OneWay}" Maximum="100" Width="40" Height="4" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Right" IsHitTestVisible="False" Visibility="{Binding HasRangePosition, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Margin="12,4" VerticalAlignment="Top"
                   Text="{DynamicResource Workspace_EmptyWatchlist}" TextWrapping="Wrap" Visibility="{Binding HasWatchlist, Converter={StaticResource InverseBoolToVis}}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,6" Visibility="{Binding CanPage, Converter={StaticResource BoolToVis}}">
            <Button Style="{StaticResource GhostButton}" Width="32" MinWidth="32" Padding="0" ToolTip="{DynamicResource QP_Previous}" AutomationProperties.Name="{DynamicResource QP_Previous}" Command="{Binding PreviousCommand}"><lucide:LucideIcon Kind="ChevronLeft" Width="16" Height="16"/></Button>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding PageText}" VerticalAlignment="Center" Margin="8,0"/>
            <Button Style="{StaticResource GhostButton}" Width="32" MinWidth="32" Padding="0" ToolTip="{DynamicResource QP_Next}" AutomationProperties.Name="{DynamicResource QP_Next}" Command="{Binding NextCommand}"><lucide:LucideIcon Kind="ChevronRight" Width="16" Height="16"/></Button>
        </StackPanel>
    </Grid>
</UserControl>
