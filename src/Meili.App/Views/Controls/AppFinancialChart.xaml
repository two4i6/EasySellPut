<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Meili.Shared.ViewModels;assembly=Meili.Shared"
 x:Class="Meili.App.Views.Controls.AppFinancialChart">
 <StackPanel>
  <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}"/>
  <TextBlock Style="{StaticResource Caption}" Text="{Binding Subtitle}" TextWrapping="Wrap" Margin="0,6,0,12"/>
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
   <ItemsControl ItemsSource="{Binding Points}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Button Click="OnPointSelected" Width="110" Padding="8" Margin="0,0,4,8" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Detail}" Background="Transparent" BorderThickness="0">
      <StackPanel>
       <Grid Height="80">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Height="{Binding ActualPositive}" Width="20" VerticalAlignment="Bottom" Background="{DynamicResource TextFillColorPrimaryBrush}" CornerRadius="3,3,0,0"/>
        <Border Grid.Column="1" Height="{Binding EstimatePositive}" Width="20" VerticalAlignment="Bottom" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="3,3,0,0"/>
       </Grid>
       <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
       <Grid Height="{Binding NegativeSpace}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Height="{Binding ActualNegative}" Width="20" VerticalAlignment="Top" Background="{DynamicResource TextFillColorPrimaryBrush}" CornerRadius="0,0,3,3"/>
        <Border Grid.Column="1" Height="{Binding EstimateNegative}" Width="20" VerticalAlignment="Top" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="0,0,3,3"/>
       </Grid>
       <TextBlock Style="{StaticResource Caption}" Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,6"/>
       <TextBlock Text="{Binding ActualText}" TextAlignment="Center" FontFamily="{DynamicResource NumberFont}"/>
       <TextBlock Text="{Binding EstimateText}" TextAlignment="Center" Foreground="{DynamicResource FocusBrush}" FontFamily="{DynamicResource NumberFont}"/>
      </StackPanel>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <TextBlock x:Name="PointDetails" Style="{StaticResource Caption}" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0"/>
 </StackPanel>
</UserControl>