<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Meili.App.Views.Controls"
             xmlns:lucide="clr-namespace:Meili.App.Views.Controls"
             x:Class="Meili.App.Views.Controls.MarketWorkspaceLayout"
             x:Name="Layout">
    <UserControl.Resources>
        <Style x:Key="WorkspaceChange" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource NumberFont}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUp}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource UpBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDown}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DownBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="WatchlistToggle" Click="OnWatchlistToggle" Padding="8,4" Margin="4,0,0,0" ToolTip="{DynamicResource QP_Watchlist}" AutomationProperties.Name="{DynamicResource QP_Watchlist}" AutomationProperties.AutomationId="WatchlistToggle" ><lucide:LucideIcon Kind="Watchlist" Width="16" Height="16"/></ToggleButton>
                    <ToggleButton x:Name="QuoteToggle" Click="OnQuoteToggle" Padding="8,4" Margin="4,0,0,0" ToolTip="{DynamicResource Workspace_Quote}" AutomationProperties.Name="{DynamicResource Workspace_Quote}" AutomationProperties.AutomationId="QuoteToggle" ><lucide:LucideIcon Kind="Info" Width="16" Height="16"/></ToggleButton>
                </StackPanel>
                <StackPanel x:Name="SymbolToolbar" DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <controls:SymbolBox x:Name="SymbolInput" Width="156" AutomationProperties.AutomationId="WorkspaceSymbol" Text="{Binding SymbolText, Mode=TwoWay}" WatchSymbols="{Binding WatchSymbols}" CommitCommand="{Binding SubmitSymbolCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Width="32" MinWidth="32" Padding="0" ToolTip="{DynamicResource Ch_Load}" AutomationProperties.Name="{DynamicResource Ch_Load}" Command="{Binding SubmitSymbolCommand}" Margin="4,0,0,0"><lucide:LucideIcon Kind="CornerDownLeft" Width="16" Height="16"/></Button>
                    </StackPanel>
                    <TextBlock Text="{Binding SymbolError}" FontSize="{DynamicResource CaptionFontSize}" MaxWidth="208" TextWrapping="Wrap"
                               Foreground="{DynamicResource DegradedBrush}" Margin="0,4,0,0" Visibility="{Binding SymbolError, Converter={StaticResource NonEmptyToVis}}"/>
                </StackPanel>
                <controls:AppFormHeader Title="{Binding Title, ElementName=Layout}" HelpText="{Binding HelpText, ElementName=Layout}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </DockPanel>
        </Border>
        <Grid x:Name="WorkspaceBody" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="WorkspaceWatchlist" Visibility="Collapsed" Background="{DynamicResource SidebarBackgroundBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <controls:MarketWatchlist x:Name="WatchlistView"/>
            </Border>
            <GridSplitter x:Name="WatchlistSplitter" Grid.Column="1" Width="6" Visibility="Collapsed"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource ControlFillColorSecondaryBrush}" Focusable="True"
                          AutomationProperties.Name="{DynamicResource Workspace_Resize}" ToolTip="{DynamicResource Workspace_Resize}"/>
            <Grid Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <ContentControl Content="{Binding WorkspaceContent, ElementName=Layout}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>
            <Border Grid.Column="3" x:Name="WorkspaceQuote" Visibility="Collapsed" Width="224" Background="{DynamicResource SidebarBackgroundBrush}" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Workspace_Quote}" FontWeight="SemiBold"/>
                        <StackPanel DataContext="{Binding Current}" Margin="0,12,0,0">
                            <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="{DynamicResource SubtitleFontSize}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Name}" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,8,0,4">
                                <TextBlock Style="{StaticResource WorkspaceChange}" Text="{Binding Change}" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="4,0,0,0"/>
                                <TextBlock FontFamily="{DynamicResource NumberFont}" Text="{Binding Price}" FontSize="{DynamicResource FontSize26}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Source}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Timestamp}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,12,0,4"/>
                            <DockPanel Margin="0,4">
                                <TextBlock DockPanel.Dock="Right" FontFamily="{DynamicResource NumberFont}" Text="{Binding Open}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource QP_OpenPrice}"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock DockPanel.Dock="Right" FontFamily="{DynamicResource NumberFont}" Text="{Binding High}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource QP_High}"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock DockPanel.Dock="Right" FontFamily="{DynamicResource NumberFont}" Text="{Binding Low}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource QP_Low}"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock DockPanel.Dock="Right" FontFamily="{DynamicResource NumberFont}" Text="{Binding PreviousClose}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Workspace_PreviousClose}"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock DockPanel.Dock="Right" FontFamily="{DynamicResource NumberFont}" Text="{Binding Volume}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource QP_Volume}"/>
                            </DockPanel>
                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,12,0,0" Padding="0,8,0,0" Visibility="{Binding Extended, Converter={StaticResource NonEmptyToVis}}">
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Extended}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
