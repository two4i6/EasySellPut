<Page x:Class="Meili.App.Views.Pages.NewsPage"
      Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
      AutomationProperties.AutomationId="NewsPageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:lucide="clr-namespace:Meili.App.Views.Controls"
    xmlns:ux="clr-namespace:Meili.App.Views.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Meili.App.Views.Controls">
    <Page.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{DynamicResource NumberFont}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FinCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{DynamicResource NumberFont}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <DataTemplate x:Key="StatementTemplate">
            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                <TextBlock Style="{StaticResource CardTitle}" FontSize="15" Text="{Binding Title}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Nf_Item}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding H0}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding H1}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="{Binding H2}" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="{Binding H3}" TextAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="13" Text="{Binding Label}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource FinCell}" Text="{Binding V0}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource FinCell}" Text="{Binding V1}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource FinCell}" Text="{Binding V2}" />
                                <TextBlock Grid.Column="4" Style="{StaticResource FinCell}" Text="{Binding V3}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

    </Page.Resources>
    <DockPanel x:Name="NewsPageLayout" MaxWidth="1248" HorizontalAlignment="Stretch">
        <StackPanel DockPanel.Dock="Top" Margin="24,16,24,12">
            <ux:AppFormHeader Title="{DynamicResource Nf_Title}" HelpText="{DynamicResource Nf_Desc}" IsPageTitle="True" Margin="0,0,0,12"/>
            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <Button DockPanel.Dock="Right" Width="36" Height="36" Margin="8,0,0,0" Padding="0" Command="{Binding ExportCommand}" ToolTip="{DynamicResource Nf_Export}" AutomationProperties.Name="{DynamicResource Nf_Export}"><ux:LucideIcon Kind="Download" Width="18" Height="18"/></Button>
                <Button DockPanel.Dock="Right" Width="36" Height="36" Margin="8,0,0,0" Padding="0" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" ToolTip="{DynamicResource Nf_Refresh}" AutomationProperties.Name="{DynamicResource Nf_Refresh}"><ux:LucideIcon Kind="Refresh" Width="18" Height="18"/></Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Padding="14,6" Margin="8,0,0,0"
                           Command="{Binding LoadFromBoxCommand}" Content="{DynamicResource Nf_Load}"  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                <controls:SymbolBox x:Name="SymbolInput" AutomationProperties.AutomationId="NewsSymbol" MinWidth="200"
                          Text="{Binding SymbolText}" WatchSymbols="{Binding WatchSymbols}" CommitCommand="{Binding LoadFromBoxCommand}" />
            </DockPanel>
            <DockPanel Margin="0,0,0,6" LastChildFill="True">
                <TextBlock Style="{StaticResource CardTitle}" FontSize="18" Text="{Binding Headline}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock DockPanel.Dock="Right" FontSize="16" FontWeight="SemiBold" FontFamily="{DynamicResource NumberFont}"
                           Text="{Binding ChangeText}" Foreground="{Binding ChangeBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </DockPanel>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding LiveQuote.Text}" ToolTip="{Binding LiveQuote.Tooltip}" VerticalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding MetaText}" Visibility="{Binding HasMetaText, Converter={StaticResource BoolToVis}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MetaText}" Margin="0,0,0,6" />
            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                <ux:AppLoading DockPanel.Dock="Left" Margin="0,0,8,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>

        <Grid x:Name="NewsWorkspace" Margin="24,0,24,24" MaxWidth="1200" HorizontalAlignment="Stretch">
            <ScrollViewer x:Name="FundamentalsPane" Style="{StaticResource PageScroller}">
                <ux:AppCard Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Nf_Fundamentals}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Stats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="150" Margin="0,0,16,12">
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Label}" />
                                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding Value}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


                    <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource Nf_NoProfile}"
                               Visibility="{Binding HasProfile, Converter={StaticResource InverseBoolToVis}}" />
                    <ux:AppDisclosure Header="{DynamicResource Nf_Profile}" HorizontalAlignment="Stretch" Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}"><StackPanel Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4"
                                   Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVis}}">
                            <Run Text="{DynamicResource Nf_Website}" />
                            <Run Text="  " />
                            <Hyperlink Command="{Binding OpenWebsiteCommand}">
                                <Run Text="{Binding WebsiteText}" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Description}" TextWrapping="Wrap" FontSize="14" />
                    </StackPanel></ux:AppDisclosure>

                    <DockPanel Margin="0,16,0,8">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Nf_FinancialTrend}" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource RangeChip}" Content="{DynamicResource Nf_Annual}" Tag="annual" Click="OnPeriodClick" />
                            <Button Style="{StaticResource RangeChip}" Content="{DynamicResource Nf_Quarterly}" Tag="quarterly" Click="OnPeriodClick" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource Nf_NoFinancials}"
                               Visibility="{Binding HasFinancials, Converter={StaticResource InverseBoolToVis}}" />
                    <StackPanel Visibility="{Binding HasFinancials, Converter={StaticResource BoolToVis}}"><ux:AppSelect ItemsSource="{Binding FinancialCharts}" SelectedItem="{Binding SelectedFinancialChart, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                        <ux:AppSelect.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></ux:AppSelect.ItemTemplate>
                    </ux:AppSelect><ContentControl Content="{Binding SelectedFinancialChart}" Margin="0,0,0,12"><ContentControl.ContentTemplate><DataTemplate><ux:AppFinancialChart/></DataTemplate></ContentControl.ContentTemplate></ContentControl></StackPanel>
<TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Nf_EarningsOutlook}" Margin="0,20,0,8"/>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding EarningsStatus}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding EstimateCharts}"><ItemsControl.ItemTemplate><DataTemplate><ux:AppCard Padding="16" Margin="0,0,0,12"><ux:AppFinancialChart/></ux:AppCard></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <ux:AppDisclosure Header="{DynamicResource Nf_StatementDetails}" HorizontalAlignment="Stretch">                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding HasFinancials, Converter={StaticResource BoolToVis}}"><StackPanel Visibility="{Binding HasFinancials, Converter={StaticResource BoolToVis}}" MinWidth="460">
                        <ContentPresenter Content="{Binding Income}" ContentTemplate="{StaticResource StatementTemplate}" Margin="0,0,0,12" />
                        <ContentPresenter Content="{Binding Balance}" ContentTemplate="{StaticResource StatementTemplate}" Margin="0,0,0,12" />
                        <ContentPresenter Content="{Binding CashFlow}" ContentTemplate="{StaticResource StatementTemplate}" />
                    </StackPanel></ScrollViewer></ux:AppDisclosure>
                </StackPanel>
                </ux:AppCard>
            </ScrollViewer>

            <DockPanel x:Name="NewsFeedPane">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="{DynamicResource Nf_News}" Margin="0,0,0,8" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Text="{DynamicResource Nf_NoNews}"
                           Visibility="{Binding HasNews, Converter={StaticResource InverseBoolToVis}}" />
                <ListView x:Name="NewsList"
                      Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="NewsList"
                          ItemsSource="{Binding News}" SelectedItem="{Binding SelectedNews, Mode=TwoWay}" BorderThickness="0"
                          Visibility="{Binding HasNews, Converter={StaticResource BoolToVis}}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="OnNewsDoubleClick" KeyDown="OnNewsKeyDown">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource ActionListItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ux:AppActionCard Style="{StaticResource ActionCardInList}" Padding="16" Command="{Binding DataContext.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" ToolTip="{Binding TimeTip}"><Run Text="{Binding Publisher}"/><Run Text="  ·  "/><Run Text="{Binding TimeText}"/></TextBlock>
                                    </StackPanel>
                                    <ux:LucideIcon Grid.Column="1" Kind="ChevronRight" Width="18" Height="18" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </ux:AppActionCard>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Page>