<Page x:Class="Meili.App.Views.Pages.ChartsPage"
      Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:lucide="clr-namespace:Meili.App.Views.Controls"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:cs="clr-namespace:Meili.Core.Settings;assembly=Meili.Core"
      xmlns:controls="clr-namespace:Meili.App.Views.Controls"
>

    <Grid x:Name="WorkspaceRoot">
        <controls:MarketWorkspaceLayout x:Name="Workspace" UseNativeQuotePanel="False" Title="{DynamicResource Nav_Charts}"/>
        <Grid x:Name="WorkspaceSurface">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid x:Name="ChartToolbar">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="RangeScroller" Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RangeTabs" ItemsSource="{Binding Ranges}" Margin="0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RangeChip}" Content="{Binding CompactTitle}" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}" Command="{Binding DataContext.SelectRangeCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding Kind}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <ToggleButton Width="32" MinWidth="32" Height="32" Padding="0" IsChecked="{Binding IsHorizontalDrawing, Mode=OneWay}" Margin="0,0,4,0"  ToolTip="{DynamicResource Ch_DrawHLineHint}" Command="{Binding StartDrawingCommand}" CommandParameter="{x:Static cs:DrawingKind.HorizontalLine}" AutomationProperties.AutomationId="ChartsDrawHLine" AutomationProperties.Name="{DynamicResource Ch_HLineShort}"><lucide:LucideIcon Kind="Minus" Width="16" Height="16"/></ToggleButton>
                        <ToggleButton Width="32" MinWidth="32" Height="32" Padding="0" IsChecked="{Binding IsTrendDrawing, Mode=OneWay}" Margin="0,0,4,0"  ToolTip="{DynamicResource Ch_DrawTrendHint1}" Command="{Binding StartDrawingCommand}" CommandParameter="{x:Static cs:DrawingKind.TrendLine}" AutomationProperties.AutomationId="ChartsDrawTrend" AutomationProperties.Name="{DynamicResource Ch_TrendShort}"><lucide:LucideIcon Kind="TrendUp" Width="16" Height="16"/></ToggleButton>
                        <ui:Button Width="56" Height="56" Appearance="Secondary" Padding="4" Margin="0,0,4,0"  Command="{Binding ClearDrawingsCommand}" ToolTip="{DynamicResource Ch_ClearAllShort}" AutomationProperties.Name="{DynamicResource Ch_ClearAllShort}"><lucide:LucideIcon Kind="Trash" Width="16" Height="16"/></ui:Button>
                            <ToggleButton x:Name="InspectorToggle" Margin="4,0,0,0" Padding="8,4" Content="{DynamicResource Ch_Tools}" IsChecked="{Binding ShowInspector, Mode=TwoWay}" AutomationProperties.AutomationId="ChartsTools"/>
                                <controls:AppPopover Header="{DynamicResource Ch_DataInfo}" Margin="4,0,0,0">
                                    <controls:AppPopover.PopupContent>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" TextWrapping="Wrap"/>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding AdjustText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </controls:AppPopover.PopupContent>
                                </controls:AppPopover>
                            <ui:Button MinHeight="32" Margin="6,0,0,0" Padding="10,4" Content="{DynamicResource Ch_Refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                            <ui:Button MinHeight="32" Margin="6,0,0,0" Padding="10,4" Content="{DynamicResource Ch_Export}" Command="{Binding ExportCommand}"/>
                        </StackPanel>
                </Grid>
            </Border>
            <DockPanel Grid.Row="1">
                    <controls:AppLoading DockPanel.Dock="Top" Margin="12,6" HorizontalAlignment="Left" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{Binding ChartNotice}" TextWrapping="Wrap" Margin="12,6"
                               Foreground="{DynamicResource DegradedBrush}" Visibility="{Binding ChartNotice, Converter={StaticResource NonEmptyToVis}}"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{Binding AdjustWarning}" TextWrapping="Wrap" Margin="12,6"
                               Foreground="{DynamicResource DegradedBrush}" Visibility="{Binding AdjustWarning, Converter={StaticResource NonEmptyToVis}}"/>
                <controls:AppDrawer x:Name="ChartInspector" ReturnFocusTarget="{Binding ElementName=InspectorToggle}" AutomationProperties.Name="{DynamicResource Ch_Indicators}" DockPanel.Dock="Right" Width="280" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" IsOpen="{Binding ShowInspector, Mode=TwoWay}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Ch_Indicators}" Margin="0,0,0,12"/>
                            <StackPanel>
                                <CheckBox Style="{StaticResource IndCheck}" Content="{Binding MaLabel}" IsChecked="{Binding ShowMa}"/>
                                <CheckBox Style="{StaticResource IndCheck}" Content="{Binding EmaLabel}" IsChecked="{Binding ShowEma}"/>
                                <CheckBox Style="{StaticResource IndCheck}" Content="{Binding BollLabel}" IsChecked="{Binding ShowBoll}"/>
                                <CheckBox Style="{StaticResource IndCheck}" Content="{DynamicResource Ch_Volume}" IsChecked="{Binding ShowVolume}"/>
                                <CheckBox Style="{StaticResource IndCheck}" Content="{Binding MacdLabel}" IsChecked="{Binding ShowMacd}"/>
                                <CheckBox Style="{StaticResource IndCheck}" Content="{Binding RsiLabel}" IsChecked="{Binding ShowRsi}"/>
                                <CheckBox Style="{StaticResource IndCheck}" Content="{Binding KdjLabel}" IsChecked="{Binding ShowKdj}"/>
                            </StackPanel>
                            <Expander Margin="0,0,0,8" Header="{DynamicResource Ch_Params}" AutomationProperties.AutomationId="ChartsIndicatorParams">
                                <WrapPanel Margin="0,8,0,0">
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PMa}" Margin="0,0,0,4"/>
                                        <ui:NumberBox Width="104" Value="{Binding MaPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="{DynamicResource FontSize13}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PEma}" Margin="0,0,0,4"/>
                                        <ui:NumberBox Width="104" Value="{Binding EmaPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="{DynamicResource FontSize13}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PBoll}" Margin="0,0,0,4"/>
                                        <ui:NumberBox Width="104" Value="{Binding BollPeriod, UpdateSourceTrigger=LostFocus}" Minimum="2" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="{DynamicResource FontSize13}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PBollWidth}" Margin="0,0,0,4"/>
                                        <ui:NumberBox Width="104" Value="{Binding BollWidth, UpdateSourceTrigger=LostFocus}" Minimum="0.5" Maximum="5" SmallChange="0.1" MaxDecimalPlaces="2" FontSize="{DynamicResource FontSize13}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PMacdFast}" Margin="0,0,0,4"/>
                                        <ui:NumberBox Width="104" Value="{Binding MacdFast, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="{DynamicResource FontSize13}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PMacdSlow}" Margin="0,0,0,4"/>
                                        <ui:NumberBox Width="104" Value="{Binding MacdSlow, UpdateSourceTrigger=LostFocus}" Minimum="2" Maximum="251" SmallChange="1" MaxDecimalPlaces="0" FontSize="{DynamicResource FontSize13}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PMacdSignal}" Margin="0,0,0,4"/>
                                        <ui:NumberBox Width="104" Value="{Binding MacdSignal, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="{DynamicResource FontSize13}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PRsi}" Margin="0,0,0,4"/>
                                        <ui:NumberBox Width="104" Value="{Binding RsiPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="{DynamicResource FontSize13}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PKdj}" Margin="0,0,0,4"/>
                                        <ui:NumberBox Width="104" Value="{Binding KdjPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="{DynamicResource FontSize13}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PKdjM1}" Margin="0,0,0,4"/>
                                        <ui:NumberBox Width="104" Value="{Binding KdjM1, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="{DynamicResource FontSize13}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PKdjM2}" Margin="0,0,0,4"/>
                                        <ui:NumberBox Width="104" Value="{Binding KdjM2, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="{DynamicResource FontSize13}"/>
                                    </StackPanel>
                                    <ui:Button VerticalAlignment="Bottom" Margin="0,0,0,8" Appearance="Secondary" Padding="12,6" Content="{DynamicResource Ch_PReset}" Command="{Binding ResetIndicatorsCommand}"/>
                                </WrapPanel>
                            </Expander>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{DynamicResource Ch_Compare}"/>
                                <ui:TextBox HorizontalAlignment="Stretch" Text="{Binding CompareText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource Ch_ComparePlaceholder}" FontSize="{DynamicResource FontSize13}" Margin="0,6,0,6" AutomationProperties.AutomationId="ChartsCompare">
                                    <ui:TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ApplyCompareCommand}"/>
                                    </ui:TextBox.InputBindings>
                                </ui:TextBox>
                                <ui:Button Appearance="Secondary" Padding="12,4" Content="{DynamicResource Ch_CompareApply}" Command="{Binding ApplyCompareCommand}"/>
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,6,0,0" Text="{Binding CompareStatus}" Foreground="{DynamicResource DegradedBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0">
                                <!-- F7: adjustment basis -->
                                <CheckBox Style="{StaticResource IndCheck}" Content="{DynamicResource Ch_AdjToggle}" IsChecked="{Binding DividendAdjusted}" ToolTip="{DynamicResource Ch_AdjToggleTip}" AutomationProperties.AutomationId="ChartsDividendAdjusted"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </controls:AppDrawer>
                <controls:WebChartControl x:Name="Chart" MinHeight="220"/>
            </DockPanel>
        </Grid>
    </Grid>
</Page>
