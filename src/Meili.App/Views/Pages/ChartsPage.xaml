<Page x:Class="Meili.App.Views.Pages.ChartsPage"
      Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:cs="clr-namespace:Meili.Core.Settings;assembly=Meili.Core"
      xmlns:controls="clr-namespace:Meili.App.Views.Controls"
>
    <Page.Resources>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource RowHighlightBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RowHighlightBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RangeChip" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IndCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>
    <Grid Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <controls:SymbolBox x:Name="SymbolInput" Width="180" MinWidth="160" Text="{Binding SymbolText}" WatchSymbols="{Binding WatchSymbols}" CommitCommand="{Binding LoadFromBoxCommand}"/>
                        <ui:Button Margin="6,0,0,0" Padding="10,6" Content="{DynamicResource Ch_Load}" Command="{Binding LoadFromBoxCommand}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton x:Name="InspectorToggle" Margin="6,0,0,0" Padding="10,6" Content="{DynamicResource Ch_Tools}" IsChecked="{Binding ShowInspector, Mode=TwoWay}" AutomationProperties.AutomationId="ChartsTools"/>
                        <ui:Button Margin="6,0,0,0" Padding="10,6" Content="{DynamicResource Ch_Refresh}" Command="{Binding RefreshCommand}"/>
                        <ui:Button Margin="6,0,0,0" Padding="10,6" Content="{DynamicResource Ch_Export}" Command="{Binding ExportCommand}"/>
                    </StackPanel>
                </DockPanel>
                <Border Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Ranges}" Margin="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RangeChip}" Content="{Binding Title}" Command="{Binding DataContext.SelectRangeCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding Kind}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="1">
            <Border DockPanel.Dock="Left" Width="88" Padding="6,12" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Ch_DrawTools}" Margin="4,0,0,12"/>
                    <ToggleButton Padding="6,6" IsChecked="{Binding IsHorizontalDrawing, Mode=OneWay}" Margin="0,0,0,8" Content="{DynamicResource Ch_HLineShort}" ToolTip="{DynamicResource Ch_DrawHLineHint}" Command="{Binding StartDrawingCommand}" CommandParameter="{x:Static cs:DrawingKind.HorizontalLine}" AutomationProperties.AutomationId="ChartsDrawHLine"/>
                    <ToggleButton Padding="6,6" IsChecked="{Binding IsTrendDrawing, Mode=OneWay}" Margin="0,0,0,8" Content="{DynamicResource Ch_TrendShort}" ToolTip="{DynamicResource Ch_DrawTrendHint1}" Command="{Binding StartDrawingCommand}" CommandParameter="{x:Static cs:DrawingKind.TrendLine}" AutomationProperties.AutomationId="ChartsDrawTrend"/>
                    <ui:Button Appearance="Secondary" Padding="10,5" Margin="0,0,0,8" Content="{DynamicResource Ch_ClearShort}" Command="{Binding ClearDrawingsCommand}"/>
                </StackPanel>
            </Border>
            <Border x:Name="ChartInspector" DockPanel.Dock="Right" Width="280" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Visibility="{Binding ShowInspector, Converter={StaticResource BoolToVis}}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Ch_Indicators}" Margin="0,0,0,12"/>
                        <StackPanel>
                            <CheckBox Style="{StaticResource IndCheck}" Content="{Binding MaLabel}" IsChecked="{Binding ShowMa}"/>
                            <CheckBox Style="{StaticResource IndCheck}" Content="{Binding EmaLabel}" IsChecked="{Binding ShowEma}"/>
                            <CheckBox Style="{StaticResource IndCheck}" Content="{Binding BollLabel}" IsChecked="{Binding ShowBoll}"/>
                            <CheckBox Style="{StaticResource IndCheck}" Content="{DynamicResource Ch_Volume}" IsChecked="{Binding ShowVolume}"/>
                            <CheckBox Style="{StaticResource IndCheck}" Content="{Binding MacdLabel}" IsChecked="{Binding ShowMacd}"/>
                            <CheckBox Style="{StaticResource IndCheck}" Content="{Binding RsiLabel}" IsChecked="{Binding ShowRsi}"/>
                            <CheckBox Style="{StaticResource IndCheck}" Content="{Binding KdjLabel}" IsChecked="{Binding ShowKdj}"/>
                        </StackPanel>
                        <Expander Margin="0,0,0,8" Header="{DynamicResource Ch_Params}" AutomationProperties.AutomationId="ChartsIndicatorParams">
                            <WrapPanel Margin="0,8,0,0">
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PMa}" Margin="0,0,0,4"/>
                                    <ui:NumberBox Width="104" Value="{Binding MaPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PEma}" Margin="0,0,0,4"/>
                                    <ui:NumberBox Width="104" Value="{Binding EmaPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PBoll}" Margin="0,0,0,4"/>
                                    <ui:NumberBox Width="104" Value="{Binding BollPeriod, UpdateSourceTrigger=LostFocus}" Minimum="2" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PBollWidth}" Margin="0,0,0,4"/>
                                    <ui:NumberBox Width="104" Value="{Binding BollWidth, UpdateSourceTrigger=LostFocus}" Minimum="0.5" Maximum="5" SmallChange="0.1" MaxDecimalPlaces="2" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PMacdFast}" Margin="0,0,0,4"/>
                                    <ui:NumberBox Width="104" Value="{Binding MacdFast, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PMacdSlow}" Margin="0,0,0,4"/>
                                    <ui:NumberBox Width="104" Value="{Binding MacdSlow, UpdateSourceTrigger=LostFocus}" Minimum="2" Maximum="251" SmallChange="1" MaxDecimalPlaces="0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PMacdSignal}" Margin="0,0,0,4"/>
                                    <ui:NumberBox Width="104" Value="{Binding MacdSignal, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PRsi}" Margin="0,0,0,4"/>
                                    <ui:NumberBox Width="104" Value="{Binding RsiPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PKdj}" Margin="0,0,0,4"/>
                                    <ui:NumberBox Width="104" Value="{Binding KdjPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PKdjM1}" Margin="0,0,0,4"/>
                                    <ui:NumberBox Width="104" Value="{Binding KdjM1, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PKdjM2}" Margin="0,0,0,4"/>
                                    <ui:NumberBox Width="104" Value="{Binding KdjM2, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13"/>
                                </StackPanel>
                                <ui:Button VerticalAlignment="Bottom" Margin="0,0,0,8" Appearance="Secondary" Padding="12,6" Content="{DynamicResource Ch_PReset}" Command="{Binding ResetIndicatorsCommand}"/>
                            </WrapPanel>
                        </Expander>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{DynamicResource Ch_Compare}"/>
                            <ui:TextBox HorizontalAlignment="Stretch" Text="{Binding CompareText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource Ch_ComparePlaceholder}" FontSize="13" Margin="0,6,0,6" AutomationProperties.AutomationId="ChartsCompare">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ApplyCompareCommand}"/>
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                            <ui:Button Appearance="Secondary" Padding="10,5" Content="{DynamicResource Ch_CompareApply}" Command="{Binding ApplyCompareCommand}"/>
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,6,0,0" Text="{Binding CompareStatus}" Foreground="{DynamicResource DegradedBrush}"/>
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0">
                            <!-- F7: adjustment basis -->
                            <CheckBox Style="{StaticResource IndCheck}" Content="{DynamicResource Ch_AdjToggle}" IsChecked="{Binding DividendAdjusted}" ToolTip="{DynamicResource Ch_AdjToggleTip}" AutomationProperties.AutomationId="ChartsDividendAdjusted"/>
                            <Border CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorSecondaryBrush}" ToolTip="{DynamicResource Ch_AdjToggleTip}" Visibility="{Binding AdjustText, Converter={StaticResource NonEmptyToVis}}">
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding AdjustText}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <controls:WebChartControl x:Name="Chart" MinHeight="220"/>
        </DockPanel>
        <Border Grid.Row="2" Padding="12,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="{Binding AdjustWarning}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="{DynamicResource DegradedBrush}" Visibility="{Binding AdjustWarning, Converter={StaticResource NonEmptyToVis}}" AutomationProperties.AutomationId="ChartsAdjustWarning"/>
                <DockPanel LastChildFill="True">
                    <ui:ProgressRing DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
<TextBlock Style="{StaticResource Caption}" Text="{Binding AdjustText}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Caption}" FontFamily="{StaticResource NumberFont}" Text="{Binding CrosshairText}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
