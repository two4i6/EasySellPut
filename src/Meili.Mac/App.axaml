<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Meili.Mac.App"
             RequestedThemeVariant="Default"
             Name="EasySellPut">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Typography: nothing in the app is smaller than 12px. PingFang SC carries the Chinese glyphs. -->
            <FontFamily x:Key="AppFont">.AppleSystemUIFont, PingFang SC</FontFamily>
            <FontFamily x:Key="NumberFont">.AppleSystemUIFont, PingFang SC</FontFamily>
            <x:Double x:Key="CaptionFontSize">12</x:Double>
            <x:Double x:Key="BodyFontSize">14</x:Double>
            <x:Double x:Key="SubtitleFontSize">16</x:Double>
            <x:Double x:Key="TitleFontSize">20</x:Double>
            <x:Double x:Key="DisplayFontSize">28</x:Double>
            <!-- Same resource names as the Windows build, so page markup reads the same on both. -->
            <ResourceDictionary.ThemeDictionaries>
                <!-- Design-time / first frame; MacTheme overwrites the same keys from ThemePalette at runtime. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F0F3FA" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F0F3FA" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#F0F3FA" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#F8F9FD" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F8F9FD" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#E0E3EB" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E0E3EB" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#131722" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#434651" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#565D6B" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#245BDB" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ErrorBarBrush" Color="#F4E4DC" />
                    <SolidColorBrush x:Key="InfoBarBrush" Color="#EDF2FF" />
                    <SolidColorBrush x:Key="StaleBadgeBrush" Color="#C4A46A" />
                    <SolidColorBrush x:Key="BadgeTextBrush" Color="#131722" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#131722" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1E222D" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1E222D" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#131722" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#1E222D" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#131722" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#2A2E39" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#2A2E39" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#363A45" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#363A45" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#D1D4DC" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B2B5BE" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A3A9B5" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#90B2FF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#131722" />
                    <SolidColorBrush x:Key="ErrorBarBrush" Color="#3A2A28" />
                    <SolidColorBrush x:Key="InfoBarBrush" Color="#222B40" />
                    <SolidColorBrush x:Key="StaleBadgeBrush" Color="#C4A46A" />
                    <SolidColorBrush x:Key="BadgeTextBrush" Color="#131722" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <!-- After the resources: the styles use StaticResource sizes defined above. -->
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://MeiliMac/Styles.axaml" />
    </Application.Styles>
</Application>
