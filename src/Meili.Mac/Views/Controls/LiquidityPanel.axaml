<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Meili.Mac.Views.Controls" xmlns:vm="using:Meili.Shared.ViewModels" x:Class="Meili.Mac.Views.Controls.LiquidityPanel" x:DataType="vm:LiquidityViewModel">
<StackPanel Spacing="12" AutomationProperties.AutomationId="MarketLiquidityPanel">
 <DockPanel><Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{DynamicResource Dash_Refresh}" AutomationProperties.Name="{DynamicResource Dash_Refresh}"><c:LucideIcon Kind="Refresh" Width="18" Height="18"/></Button><TextBlock DockPanel.Dock="Right" Classes="Caption" Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0"/><c:AppHelp DockPanel.Dock="Right" HelpText="{DynamicResource Liq_MacroHelp}"/><TextBlock Classes="SectionTitle" Text="{DynamicResource Liq_Title}" VerticalAlignment="Center"/></DockPanel>
 <c:AppLoading IsVisible="{Binding IsBusy}"/>
 <c:AppCard Padding="16" Margin="0,0,8,0"><Grid ColumnDefinitions="Auto,*">
  <Grid Width="{StaticResource GaugeWidth}" Height="{StaticResource GaugeHeight}" Margin="0,0,24,0">
   <c:AppGauge Value="{Binding PressureValue}" LowBrush="{DynamicResource HealthyBrush}" NormalBrush="{DynamicResource UnknownBrush}" HighBrush="{DynamicResource DegradedBrush}" CriticalBrush="{DynamicResource DangerBrush}" MarkerBrush="{DynamicResource TextFillColorPrimaryBrush}"/>
   <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"><TextBlock Text="{Binding PressureText}" FontSize="{StaticResource DisplayFontSize}"/><TextBlock Text="/100" Classes="Caption" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{Binding PressureBand}" Classes="Caption" HorizontalAlignment="Center"/></StackPanel>
  </Grid>
  <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"><DockPanel><c:AppHelp DockPanel.Dock="Right" HelpText="{Binding PressureHelp}"/><TextBlock Classes="CardTitle" Text="{DynamicResource Liq_PressureTitle}" VerticalAlignment="Center"/></DockPanel><TextBlock Classes="Body" Text="{DynamicResource Liq_PressureNote}" TextWrapping="Wrap"/><TextBlock Classes="Caption" Text="{DynamicResource Liq_PressureWeights}" TextWrapping="Wrap"/><TextBlock Classes="Caption" Text="{Binding PressureDates}" TextWrapping="Wrap"/></StackPanel>
 </Grid></c:AppCard>
 <ItemsControl ItemsSource="{Binding Metrics}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:LiquidityMetricCard">
  <c:AppCard Margin="0,0,8,8" Padding="16"><StackPanel Spacing="6"><DockPanel><c:AppHelp DockPanel.Dock="Right" HelpText="{Binding Help}"/><TextBlock Classes="CardTitle" Text="{Binding Title}" VerticalAlignment="Center"/></DockPanel><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="SectionTitle" Text="{Binding Value}" FontSize="{StaticResource DisplayFontSize}"/><TextBlock Classes="Caption" Text="{Binding Unit}" VerticalAlignment="Center"/></StackPanel><TextBlock Classes="Caption" Text="{Binding Date}" TextWrapping="Wrap"/></StackPanel></c:AppCard>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <DockPanel Margin="0,8,0,0"><c:AppHelp DockPanel.Dock="Right" HelpText="{DynamicResource Liq_HeatHelp}"/><TextBlock Classes="CardTitle" Text="{DynamicResource Liq_HeatTitle}" VerticalAlignment="Center"/></DockPanel>
 <TextBlock Classes="Caption" Text="{DynamicResource Liq_Legend}"/>
 <ItemsControl ItemsSource="{Binding Sectors}" x:Name="SectorHeatmap"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SectorLiquidityCard">
 <c:AppActionCard Margin="0,0,8,8" Padding="14" Background="{Binding HeatBrush}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding $parent[c:LiquidityPanel].((vm:LiquidityViewModel)DataContext).OpenSectorCommand}" CommandParameter="{Binding Symbol}" ToolTip.Tip="{Binding Help}" AutomationProperties.Name="{Binding Help}"><StackPanel Spacing="6"><DockPanel><TextBlock DockPanel.Dock="Right" Classes="Caption" Text="{Binding Symbol}"/><TextBlock Classes="CardTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Classes="SectionTitle" Text="{Binding Value}" FontSize="{StaticResource DisplayFontSize}"/><TextBlock Classes="Caption" Text="{Binding Date}"/></StackPanel></c:AppActionCard>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel>
</UserControl>
