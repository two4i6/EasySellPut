                "type": "number",
                "description": "Optional decimal IV"
              },
              "multiplier": {
                "type": "integer",
                "description": "default 100; stock uses 1"
              }
            },
            "required": [
              "type",
              "side",
              "quantity",
              "premium"
            ],
            "additionalProperties": false
          },
          "description": "Explicit position legs. Preserve entry premiums, side, expiry, quantity and multiplier; never fabricate quotes."
        },
        "spot": {
          "type": "number",
          "description": "Underlying price per share. Use an observed quote or explicitly label a hypothetical scenario.",
          "minimum": 0,
          "maximum": 1000000000
        },
        "valuationTime": {
          "type": "string",
          "description": "ISO-8601 instant; omitted means intrinsic settlement for same-expiry legs",
          "maxLength": 200
        },
        "horizonDays": {
          "type": "integer",
          "description": "Calendar days forward from the explicit valuation time; see schema bounds.",
          "minimum": 0,
