[
  {
    "name": "get_expirations",
    "description": "List option expiration dates.",
    "writes": false,
    "schema": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "US ticker, e.g. NVDA or BRK.B. Resolve ambiguous company names with search_symbols.",
          "maxLength": 200
        }
      },
      "required": [
        "symbol"
      ],
      "additionalProperties": false
    },
    "entryPoint": "engine/report.mjs",
    "hostOperations": [
      "get_expirations"
    ]
  },
  {
    "name": "get_option_chain",
    "description": "Paginated option contracts with source metadata and non-executable midpoint/last entry references (missing quotes stay null). Request expiry YYYY-MM-DD and optional right/strike filters.",
    "writes": false,
    "schema": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "US ticker, e.g. NVDA or BRK.B. Resolve ambiguous company names with search_symbols.",
          "maxLength": 200
        },
        "expiry": {
          "type": "string",
          "description": "Listed option expiration YYYY-MM-DD; discover actual dates with get_expirations.",
          "maxLength": 200
        },
        "right": {
          "type": "string",
          "description": "Option right; use the exact call/put enum spelling in this schema.",
          "enum": [
            "call",
            "put"
          ],
          "maxLength": 200
        },
        "minStrike": {
          "type": "number",
          "description": "Inclusive strike filter in underlying quote currency; not an option premium."
        },
        "maxStrike": {
          "type": "number",
          "description": "Inclusive strike filter in underlying quote currency; not an option premium."
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based offset, default 0.",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "description": "Page size 1..500, default 100.",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "symbol"
      ],
      "additionalProperties": false
    },
    "entryPoint": "engine/report.mjs",
    "hostOperations": [
      "get_option_chain"
    ]
  },
  {
    "name": "analyze_strategy",
    "description": "Position expiry P/L, boundedness, breakevens, optional pre-expiry Greeks and Reg-T estimate. Mixed expiries require valuationTime and IV. No network.",
    "writes": false,
    "schema": {
      "type": "object",
      "properties": {
        "legs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "",
                "enum": [
                  "Call",
                  "Put",
                  "Stock"
                ],
                "maxLength": 200
              },
              "side": {
                "type": "string",
                "description": "",
                "enum": [
                  "Long",
                  "Short"
                ],
                "maxLength": 200
              },
              "quantity": {
                "type": "integer",
                "description": ""
              },
              "strike": {
                "type": "number",
                "description": ""
              },
              "premium": {
                "type": "number",
                "description": ""
              },
              "expiry": {
                "type": "string",
                "description": "YYYY-MM-DD; required for options",
                "maxLength": 200
              },
              "iv": {
                "type": "number",
                "description": "Optional decimal IV"
              },
              "multiplier": {
                "type": "integer",
                "description": "default 100; stock uses 1"
              }
            },
            "required": [
              "type",
              "side",
              "quantity",
              "premium"
            ],
            "additionalProperties": false
          },
          "description": "Explicit position legs. Preserve entry premiums, side, expiry, quantity and multiplier; never fabricate quotes."
        },
        "spot": {
          "type": "number",
          "description": "Underlying price per share. Use an observed quote or explicitly label a hypothetical scenario."
        },
        "valuationTime": {
          "type": "string",
          "description": "ISO-8601 instant",
          "maxLength": 200
        },
        "rate": {
          "type": "number",
          "description": "Annual continuously compounded rate as a decimal fraction, e.g. 0.04 = 4%; obtain pricing assumptions before valuation."
        },
        "dividendYield": {
          "type": "number",
          "description": "Annual dividend yield as a decimal fraction, e.g. 0.02 = 2%; preserve provenance and unavailable-yield fallback."
        },
        "volatility": {
          "type": "number",
          "description": "Fallback decimal IV"
        },
        "low": {
          "type": "number",
          "description": "Underlying-price bound for the payoff/scenario plot, not an option premium."
        },
        "high": {
          "type": "number",
          "description": "Underlying-price bound for the payoff/scenario plot, not an option premium."
        },
        "points": {
          "type": "integer",
          "description": "2..1001, default 101"
        }
      },
      "required": [
        "legs",
        "spot"
      ],
      "additionalProperties": false
    },
    "entryPoint": "engine/report.mjs",
    "hostOperations": [
      "analyze_strategy"
    ]
  },
