  {
    "name": "get_chart_drawings",
    "description": "Read a symbol's persisted local horizontal/trend lines; does not control chart windows.",
    "writes": false,
    "schema": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "US ticker, e.g. NVDA or BRK.B. Resolve ambiguous company names with search_symbols.",
          "maxLength": 200
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based offset, default 0.",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "description": "Page size 1..500, default 100.",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "symbol"
      ],
      "additionalProperties": false
    },
    "entryPoint": "engine/report.mjs",
    "hostOperations": [
      "get_chart_drawings"
    ]
  },
  {
    "name": "add_chart_drawing",
    "description": "Persist a bounded horizontal/trend line in the shared drawing store with conflict protection. Trend lines need distinct time1/time2.",
    "writes": true,
    "schema": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "US ticker, e.g. NVDA or BRK.B. Resolve ambiguous company names with search_symbols.",
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "description": "Strategy/drawing category; select the exact schema enum and required matching fields.",
          "enum": [
            "HorizontalLine",
            "TrendLine"
          ],
          "maxLength": 200
        },
        "price1": {
          "type": "number",
          "description": "Drawing anchor price in the underlying quote currency; not a screen coordinate.",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "time1": {
          "type": "string",
          "description": "ISO-8601 instant",
          "maxLength": 200
        },
        "price2": {
          "type": "number",
          "description": "Drawing anchor price in the underlying quote currency; not a screen coordinate.",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "time2": {
          "type": "string",
          "description": "ISO-8601 instant",
          "maxLength": 200
        }
      },
      "required": [
        "symbol",
        "kind",
        "price1"
      ],
      "additionalProperties": false
    },
    "entryPoint": "engine/report.mjs",
    "hostOperations": [
      "add_chart_drawing"
    ]
  },
  {
    "name": "update_chart_drawing",
    "description": "Replace one persisted drawing by absolute zero-based index (offset + row index) using the revision from get_chart_drawings. Stale revisions fail without overwriting.",
    "writes": true,
    "schema": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "US ticker, e.g. NVDA or BRK.B. Resolve ambiguous company names with search_symbols.",
          "maxLength": 200
        },
        "index": {
          "type": "integer",
          "description": "index argument for update_chart_drawing; observe this field's schema type, bounds and operation semantics.",
          "minimum": 0,
          "maximum": 199
        },
        "revision": {
          "type": "string",
          "description": "Exact revision from get_chart_drawings",
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "description": "Strategy/drawing category; select the exact schema enum and required matching fields.",
          "enum": [
            "HorizontalLine",
            "TrendLine"
          ],
          "maxLength": 200
        },
        "price1": {
          "type": "number",
          "description": "Drawing anchor price in the underlying quote currency; not a screen coordinate.",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "time1": {
          "type": "string",
          "description": "ISO-8601 instant",
          "maxLength": 200
        },
        "price2": {
          "type": "number",
          "description": "Drawing anchor price in the underlying quote currency; not a screen coordinate.",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "time2": {
          "type": "string",
          "description": "ISO-8601 instant",
          "maxLength": 200
        }
      },
      "required": [
        "symbol",
        "index",
        "revision",
        "kind",
        "price1"
      ],
      "additionalProperties": false
    },
    "entryPoint": "engine/report.mjs",
    "hostOperations": [
      "update_chart_drawing"
    ]
  },
  {
    "name": "delete_chart_drawing",
    "description": "Delete one persisted drawing by absolute zero-based index (offset + row index) using the revision from get_chart_drawings. Other drawings remain; stale revisions fail.",
    "writes": true,
    "schema": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
