[
  {
    "name": "get_bars",
    "description": "Historical OHLCV with provenance, adjustment and offline-cache status. Missing OHLC is null, never fabricated.",
    "writes": false,
    "schema": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "US ticker, e.g. NVDA or BRK.B. Resolve ambiguous company names with search_symbols.",
          "maxLength": 200
        },
        "interval": {
          "type": "string",
          "description": "default 1d",
          "enum": [
            "1m",
            "5m",
            "15m",
            "30m",
            "1h",
            "1d",
            "1w",
            "1mo"
          ],
          "maxLength": 200
        },
        "from": {
          "type": "string",
          "description": "ISO-8601 instant",
          "maxLength": 200
        },
        "to": {
          "type": "string",
          "description": "ISO-8601 instant",
          "maxLength": 200
        },
        "adjust": {
          "type": "string",
          "description": "default split",
          "enum": [
            "split",
            "total"
          ],
          "maxLength": 200
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based offset, default 0.",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "description": "Page size 1..500, default 100.",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "symbol"
      ],
      "additionalProperties": false
    },
    "entryPoint": "engine/report.mjs",
    "hostOperations": [
      "get_bars"
    ]
  },
  {
    "name": "get_market_events",
    "description": "Recent news and current earnings/ex-dividend calendar snapshot, with source, exact/date-only timing and estimate/confirmation metadata. Not a historical corporate-action archive.",
    "writes": false,
    "schema": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "US ticker, e.g. NVDA or BRK.B. Resolve ambiguous company names with search_symbols.",
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "description": "default all",
          "enum": [
            "all",
            "news",
            "earnings",
            "ex_dividend"
          ],
          "maxLength": 200
        },
        "from": {
          "type": "string",
          "description": "YYYY-MM-DD, inclusive Eastern calendar date",
          "maxLength": 200
        },
        "to": {
          "type": "string",
          "description": "YYYY-MM-DD, inclusive Eastern calendar date",
          "maxLength": 200
        },
        "limit": {
          "type": "integer",
          "description": "1..100, default 50",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "symbol"
      ],
      "additionalProperties": false
    },
    "entryPoint": "engine/report.mjs",
    "hostOperations": [
      "get_market_events"
    ]
  },
  {
