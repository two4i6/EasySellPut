          "enum": [
            "1m",
            "5m",
            "15m",
            "30m",
            "1h",
            "1d",
            "1w",
            "1mo"
          ],
          "maxLength": 200
        },
        "from": {
          "type": "string",
          "description": "ISO-8601 instant",
          "maxLength": 200
        },
        "to": {
          "type": "string",
          "description": "ISO-8601 instant",
          "maxLength": 200
        },
        "adjust": {
          "type": "string",
          "description": "default split",
          "enum": [
            "split",
            "total"
          ],
          "maxLength": 200
        },
        "indicators": {
          "type": "object",
          "properties": {
            "maPeriod": {
              "type": "integer",
