          "type": "string",
          "description": "Exact revision from get_chart_drawings",
          "maxLength": 200
        }
      },
      "required": [
        "symbol",
        "index",
        "revision"
      ],
      "additionalProperties": false
    },
    "entryPoint": "engine/report.mjs",
    "hostOperations": [
      "delete_chart_drawing"
