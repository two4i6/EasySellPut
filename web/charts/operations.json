              "minimum": 1,
              "maximum": 250
            },
            "rsiPeriod": {
              "type": "integer",
              "description": "",
              "minimum": 1,
              "maximum": 250
            },
            "kdjPeriod": {
              "type": "integer",
              "description": "",
              "minimum": 1,
