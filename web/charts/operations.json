            "kdjM1": {
              "type": "integer",
              "description": "",
              "minimum": 1,
              "maximum": 250
            },
            "kdjM2": {
              "type": "integer",
              "description": "",
              "minimum": 1,
              "maximum": 250
            }
          },
          "required": [],
