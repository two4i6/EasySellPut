              "maximum": 250
            },
            "emaPeriod": {
              "type": "integer",
              "description": "",
              "minimum": 1,
              "maximum": 250
            },
            "bollPeriod": {
              "type": "integer",
              "description": "",
              "minimum": 2,
              "maximum": 250
            },
            "bollWidth": {
              "type": "number",
