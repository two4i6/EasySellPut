        "compareSymbol": {
          "type": "string",
          "description": "Optional comparison ticker. Rebase only on shared timestamps and retain missing-basis uncertainty.",
          "maxLength": 200
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based offset, default 0.",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "description": "Page size 1..500, default 100.",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "symbol"
      ],
      "additionalProperties": false
