{
  "schemaVersion": 1,
  "cases": [
    {
      "operation": "search_symbols",
      "arguments": {
        "query": "apple"
      },
      "expect": {
        "/data/0/symbol": {
          "equals": "AAPL"
        }
      },
      "compare": [
        "/data"
      ]
    },
    {
      "operation": "get_quotes",
      "arguments": {
        "symbols": [
          "AAPL",
          "MSFT"
        ]
      },
      "expect": {
        "/data/quotes/0/source": {
          "equals": "fixture"
        },
        "/data/missingSymbols": {
          "equals": [
            "MSFT"
          ]
        }
      },
      "compare": [
        "/data"
      ]
    },
    {
      "operation": "get_bars",
      "arguments": {
        "symbol": "AAPL",
        "limit": 1
      },
      "expect": {
        "/data/offlineCache": {
          "equals": true
        },
        "/data/page/items/0/open": {
          "equals": null
        },
        "/data/page/nextOffset": {
          "equals": 1
        }
      },
      "compare": [
        "/data"
      ]
    },
    {
      "operation": "get_expirations",
      "arguments": {
        "symbol": "AAPL"
      },
      "expect": {
        "/data": {
          "equals": [
            "2027-06-18"
          ]
        }
      },
      "compare": [
        "/data"
      ]
    },
    {
      "operation": "get_option_chain",
      "arguments": {
        "symbol": "AAPL",
        "right": "put"
      },
      "expect": {
        "/data/page/total": {
          "equals": 1
        },
        "/data/page/items/0/contractSymbol": {
          "equals": "put"
        }
      },
      "compare": [
        "/data"
      ]
    },
    {
      "operation": "get_fundamentals",
      "arguments": {
        "symbol": "AAPL"
      },
      "expect": {
        "/data/symbol": {
          "equals": "AAPL"
        },
        "/data/source": {
          "equals": "fixture"
        }
      },
      "compare": [
        "/data"
      ]
    },
    {
      "operation": "get_financials",
      "arguments": {
        "symbol": "AAPL"
      },
      "expect": {
        "/data/source": {
          "equals": "fixture"
        },
        "/data/lines": {
          "equals": []
        }
      },
      "compare": [
        "/data"
      ]
    },
    {
      "operation": "get_news",
      "arguments": {
        "symbol": "AAPL"
      },
      "expect": {
        "/data/0/title": {
          "equals": "fixture"
        },
        "/data/0/url": {
          "equals": "https://example.com"
        }
      },
      "compare": [
        "/data"
      ]
    },
    {
      "operation": "get_source_health",
      "arguments": {},
      "expect": {
        "/data/scope": {
          "equals": "current_process"
        }
      },
      "compare": [
        "/data/scope"
      ]
    },
    {
      "operation": "calculate_option",
      "arguments": {
        "right": "call",
        "spot": 100,
        "strike": 100,
        "years": 1,
        "rate": 0.05,
        "volatility": 0.2
      },
      "expect": {
        "/data/status": {
          "equals": "ok"
        },
        "/data/greeks/price": {
          "approx": 10.450583572185565,
          "tolerance": 1e-06
        }
      },
      "compare": [
        "/data"
      ]
    },
    {
      "operation": "calculate_indicators",
      "arguments": {
        "closes": [
          1,
          2,
          3,
          4
        ],
        "period": 3
      },
      "expect": {
        "/data/sma": {
          "equals": [
            null,
            null,
            2,
            3
          ]
        }
      },
      "compare": [
        "/data"
      ]
    },
    {
      "operation": "analyze_strategy",
      "arguments": {
        "spot": 100,
        "points": 5,
        "legs": [
          {
            "type": "Call",
            "side": "Short",
            "quantity": 1,
            "strike": 110,
            "premium": 2,
            "expiry": "2027-06-18"
          }
        ]
      },
      "expect": {
        "/data/payoff/isMaxLossUnbounded": {
          "equals": true
        },
        "/data/payoff/maxLoss": {
          "equals": null
        },
        "/data/netCost": {
          "equals": -200
        }
      },
      "compare": [
        "/data"
      ]
    },
    {
      "operation": "get_settings",
      "arguments": {},
      "expect": {
        "/data/language": {
          "equals": "zh-CN"
        }
      },
      "compare": [
        "/data/language",
        "/data/proxyMode"
      ]
    },
    {
      "operation": "create_watchlist_group",
      "arguments": {
        "name": "Coverage"
      },
      "expect": {
        "/data/group/name": {
          "equals": "Coverage"
        }
      },
      "capture": {
        "groupId": "/data/group/id"
      },
      "compare": [
        "/data/group/name"
      ]
    },
    {
      "operation": "rename_watchlist_group",
      "arguments": {
        "groupId": "${groupId}",
        "name": "Renamed"
      },
      "expect": {
        "/data/groups/1/name": {
          "equals": "Renamed"
        }
      },
      "compare": [
        "/data/groups/1/name"
      ]
    },
    {
      "operation": "add_watchlist_symbol",
      "arguments": {
        "groupId": "${groupId}",
        "symbol": "AAPL"
      },
      "expect": {
        "/data/groups/1/symbols": {
          "equals": [
            "AAPL"
          ]
        }
      },
      "compare": [
        "/data/groups/1/symbols"
      ]
    },
    {
      "operation": "get_watchlists",
      "arguments": {},
      "expect": {
        "/data/1/name": {
          "equals": "Renamed"
        },
        "/data/1/symbols": {
          "equals": [
            "AAPL"
          ]
        }
      },
      "compare": [
        "/data/1/symbols"
      ]
    },
    {
      "operation": "remove_watchlist_symbol",
      "arguments": {
        "groupId": "${groupId}",
        "symbol": "AAPL"
      },
      "expect": {
        "/data/groups/1/symbols": {
          "equals": []
        }
      },
      "compare": [
        "/data/groups/1/symbols"
      ]
    },
    {
      "operation": "delete_watchlist_group",
      "arguments": {
        "groupId": "${groupId}"
      },
      "expect": {
        "/data/groups": {
          "length": 1
        }
      },
      "compare": [
        "/data/groups"
      ]
    },
    {
      "operation": "save_strategy",
      "arguments": {
        "name": "Coverage put",
        "symbol": "AAPL",
        "legs": [
          {
            "type": "Put",
            "side": "Short",
            "quantity": 1,
            "strike": 95,
            "premium": 2.5,
            "expiry": "2027-06-18"
          }
        ]
      },
      "expect": {
        "/data/name": {
          "equals": "Coverage put"
        },
        "/data/legs/0/multiplier": {
          "equals": 100
        }
      },
      "compare": [
        "/data/name",
        "/data/legs"
      ]
    },
    {
      "operation": "get_saved_strategies",
      "arguments": {},
      "expect": {
        "/data/0/name": {
          "equals": "Coverage put"
        }
      },
      "compare": [
        "/data/0/legs"
      ]
    },
    {
      "operation": "delete_strategy",
      "arguments": {
        "name": "Coverage put"
      },
      "expect": {
        "/data/deleted": {
          "equals": "Coverage put"
        }
      },
      "compare": [
        "/data"
      ]
    },
    {
      "operation": "save_alert",
      "arguments": {
        "symbol": "AAPL",
        "kind": "PriceAbove",
        "threshold": 120
      },
      "expect": {
        "/data/threshold": {
          "equals": 120
        },
        "/data/hasSeenQuote": {
          "equals": false
        }
      },
      "capture": {
        "alertId": "/data/id"
      },
      "compare": [
        "/data/symbol",
        "/data/kind",
        "/data/threshold"
      ]
    },
    {
      "operation": "get_alerts",
      "arguments": {},
      "expect": {
        "/data/0/symbol": {
          "equals": "AAPL"
        },
        "/data/0/enabled": {
          "equals": true
        }
      },
      "compare": [
        "/data/0/kind",
        "/data/0/threshold"
      ]
    },
    {
      "operation": "set_alert_enabled",
      "arguments": {
        "id": "${alertId}",
        "enabled": false
      },
      "expect": {
        "/data/enabled": {
          "equals": false
        }
      },
      "compare": [
        "/data/enabled"
      ]
    },
    {
      "operation": "get_alert_history",
      "arguments": {},
      "expect": {
        "/data/total": {
          "equals": 0
        },
        "/data/items": {
          "equals": []
        }
      },
      "compare": [
        "/data"
      ]
    },
    {
      "operation": "delete_alert",
      "arguments": {
        "id": "${alertId}"
      },
      "expect": {
        "/data/deleted": {
          "equals": "${alertId}"
        }
      },
      "compare": [
        "/success"
      ]
    }
  ]
}
